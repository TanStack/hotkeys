{
  "name": "@tanstack/solid-hotkeys",
  "version": "0.26.2",
  "description": "SolidJS adapter for TanStack Hotkeys",
  "author": "Tanner Linsley",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanStack/hotkeys.git",
    "directory": "packages/solid-hotkeys"
  },
  "homepage": "https://tanstack.com/hotkeys",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/tannerlinsley"
  },
  "keywords": [
    "solid",
    "solidjs",
    "tanstack",
    "hotkeys",
    "keyboard",
    "shortcuts",
    "tanstack-intent"
  ],
  "scripts": {
    "clean": "premove ./build ./dist",
    "lint": "oxlint ./src",
    "lint:fix": "oxlint ./src --fix",
    "test:oxlint": "oxlint ./src",
    "test:lib": "vitest",
    "test:lib:dev": "pnpm test:lib --watch",
    "test:coverage": "vitest --coverage",
    "test:types": "tsc",
    "build": "tsdown",
    "test:build": "publint --strict && node ../../scripts/verify-package.ts"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "skills"
  ],
  "dependencies": {
    "@tanstack/hotkeys": "workspace:*"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^1.0.0-rc.2",
    "@solidjs/vite-plugin": "^3.0.1",
    "@solidjs/web": "^2.0.3",
    "@tanstack/hotkeys-test-utils": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "solid-js": "^2.0.3"
  },
  "peerDependencies": {
    "solid-js": "^2.0.0"
  }
}
