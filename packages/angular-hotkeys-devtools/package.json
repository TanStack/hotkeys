{
  "name": "@tanstack/angular-hotkeys-devtools",
  "version": "0.5.5",
  "description": "Angular devtools for TanStack Hotkeys",
  "author": "Tanner Linsley",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanStack/hotkeys.git",
    "directory": "packages/angular-hotkeys-devtools"
  },
  "homepage": "https://tanstack.com/hotkeys",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/tannerlinsley"
  },
  "keywords": [
    "angular",
    "tanstack",
    "keys",
    "devtools",
    "hotkeys",
    "keyboard"
  ],
  "scripts": {
    "clean": "premove ./build ./dist",
    "lint": "oxlint ./src",
    "lint:fix": "oxlint ./src --fix",
    "test:oxlint": "oxlint ./src",
    "test:lib": "vitest",
    "test:lib:dev": "pnpm test:lib --watch",
    "test:coverage": "vitest --coverage",
    "test:types": "tsc",
    "build": "tsdown",
    "test:build": "publint --strict && node ../../scripts/verify-package.ts"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./production": "./dist/production.js",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@angular/core": ">=21.0.0",
    "@tanstack/angular-devtools": ">=0.0.13"
  },
  "peerDependenciesMeta": {
    "@tanstack/angular-devtools": {
      "optional": true
    }
  },
  "dependencies": {
    "@tanstack/devtools-utils": "^0.7.2",
    "@tanstack/hotkeys-devtools": "workspace:*"
  },
  "devDependencies": {
    "@angular/common": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/platform-browser-dynamic": "^22.2.5",
    "@tanstack/angular-hotkeys": "workspace:*",
    "@tanstack/hotkeys-test-utils": "workspace:*"
  }
}
